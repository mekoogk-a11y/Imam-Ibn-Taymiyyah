# ============================================================
# IBN TAYMIYYAH DIGITAL ENCYCLOPEDIA (موسوعة شيخ الإسلام ابن تيمية)
# Environment Configuration Template
# ============================================================

# Application Environment
NODE_ENV=development
PORT=3000

# Google Gemini API Key (Server-Side Only for AI Research Assistant)
GEMINI_API_KEY=

# PostgreSQL Database Configuration
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/ibn_taymiyyah_db
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=ibn_taymiyyah_db
POSTGRES_PORT=5432

# OpenSearch Configuration (for distributed full-text search)
OPENSEARCH_URL=http://localhost:9200

# Redis Cache
REDIS_URL=redis://localhost:6379

# Security & Sessions
JWT_SECRET=scholarly_jwt_secret_replace_in_production
SESSION_SECRET=scholarly_session_secret_replace_in_production
